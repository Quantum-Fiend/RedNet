FROM rust:1.75-bookworm

WORKDIR /app

# Copy Cargo files
COPY Cargo.toml Cargo.lock* ./

# Create dummy main to cache dependencies
RUN mkdir src && \
    echo "fn main() {}" > src/lib.rs && \
    cargo build --release && \
    rm -rf src

# Copy actual source code
COPY . .

# Build the library
RUN cargo build --release

CMD ["cargo", "test", "--release"]
