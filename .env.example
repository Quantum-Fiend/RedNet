# RedNet Environment Configuration

# Backend Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=rednet-dev-secret-change-in-production

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rednet
POSTGRES_USER=rednet
POSTGRES_PASSWORD=rednet_secure_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Security Configuration
BCRYPT_ROUNDS=10
JWT_EXPIRATION=24h

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=false
